# Copy this file to `.env` in the repo root and fill in real values.
# `.env` is gitignored — never commit real secrets.

# ---------------------------------------------------------------------------
# Postgres (used by docker-compose / local db provisioning)
# ---------------------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=fgproject

# ---------------------------------------------------------------------------
# Database (bound to DatabaseOptions via IConfiguration)
# `__` maps to `:` in the config path (Database:ConnectionString).
# The three Migrations*/DefaultSchema keys below are optional — they have
# defaults in appsettings.json + DatabaseOptions. Uncomment to override.
# ---------------------------------------------------------------------------
Database__ConnectionString=Host=localhost;Port=5433;Database=fgproject;Username=postgres;Password=
# Database__MigrationsHistoryTable=__EFMigrationsHistory
# Database__MigrationsHistorySchema=config
# Database__DefaultSchema=app

# ---------------------------------------------------------------------------
# Auth (bound to AuthOptions)
# SigningKey must be at least 32 characters for HS256. Generate with e.g.:
#   openssl rand -base64 48
# Expiry is a TimeSpan (HH:MM:SS).
# ---------------------------------------------------------------------------
Auth__Issuer=fg-project
Auth__Audience=fg-project-clients
Auth__SigningKey=
Auth__Expiry=01:00:00
